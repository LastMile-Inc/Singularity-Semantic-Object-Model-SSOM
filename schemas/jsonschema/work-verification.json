{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ssom.dev/schema/work-verification.json",
  "title": "SSOM Work Verification",
  "description": "Post-work validation or rejection evidence. Work verification must identify the evidence used to validate or reject restoration.",
  "type": "object",
  "required": [
    "verification_id",
    "subject_ref",
    "work_execution_ref",
    "verification_status",
    "verification_method",
    "restoration_status",
    "evidence_refs",
    "verified_at",
    "provenance",
    "temporal_integrity",
    "ssom_version"
  ],
  "properties": {
    "verification_id": {
      "type": "string",
      "pattern": "^urn:ssom:work-verification:"
    },
    "ssom_version": {
      "type": "string"
    },
    "subject_ref": {
      "type": "string"
    },
    "work_execution_ref": {
      "type": "string"
    },
    "verification_status": {
      "$ref": "common.json#/$defs/verificationStatus"
    },
    "verification_method": {
      "type": "string"
    },
    "restoration_status": {
      "$ref": "common.json#/$defs/restorationStatus"
    },
    "verifier": {
      "$ref": "common.json#/$defs/responsibleParty"
    },
    "evidence_refs": {
      "$ref": "common.json#/$defs/evidenceRefs"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "provenance": {
      "$ref": "common.json#/$defs/provenance"
    },
    "temporal_integrity": {
      "$ref": "common.json#/$defs/temporalIntegrity"
    },
    "policy_evidence": {
      "$ref": "common.json#/$defs/policyEvidence"
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}