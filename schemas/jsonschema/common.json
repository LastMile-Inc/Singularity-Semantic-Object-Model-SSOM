{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ssom.dev/schema/common.json",
  "title": "SSOM Common Types",
  "type": "object",
  "$defs": {
    "provenance": {
      "type": "object",
      "required": [
        "source_platform",
        "source_authority_id",
        "source_reference",
        "lineage_id",
        "ingest_time",
        "processing_time"
      ],
      "properties": {
        "source_platform": {
          "type": "string"
        },
        "source_authority_id": {
          "type": "string"
        },
        "source_reference": {
          "type": "string"
        },
        "source_message_identity": {
          "type": "string"
        },
        "mapping_package_id": {
          "type": "string"
        },
        "mapping_version": {
          "type": "string"
        },
        "adapter_version": {
          "type": "string"
        },
        "lineage_id": {
          "type": "string"
        },
        "ingest_time": {
          "type": "string",
          "format": "date-time"
        },
        "processing_time": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": true
    },
    "quality": {
      "type": "object",
      "required": [
        "status",
        "validation_status"
      ],
      "properties": {
        "status": {
          "enum": [
            "good",
            "uncertain",
            "bad",
            "estimated",
            "missing"
          ]
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_quality": {},
        "mapping_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "identity_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "validation_status": {
          "enum": [
            "valid",
            "invalid",
            "partial",
            "quarantined"
          ]
        }
      },
      "additionalProperties": true
    },
    "temporalIntegrity": {
      "type": "object",
      "required": [
        "event_time",
        "receive_time",
        "processing_time",
        "delivery_classification"
      ],
      "properties": {
        "event_time": {
          "type": "string",
          "format": "date-time"
        },
        "source_time": {
          "type": "string",
          "format": "date-time"
        },
        "receive_time": {
          "type": "string",
          "format": "date-time"
        },
        "processing_time": {
          "type": "string",
          "format": "date-time"
        },
        "time_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ordering_scope": {
          "type": "string"
        },
        "delivery_classification": {
          "enum": [
            "live",
            "retained_snapshot",
            "replay",
            "backfill",
            "late_arrival",
            "reconstructed",
            "manual_entry"
          ]
        }
      },
      "additionalProperties": true
    },
    "policyEvidence": {
      "type": "object",
      "properties": {
        "classification": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "retention_class": {
          "type": "string"
        },
        "sharing_eligibility": {
          "type": "string"
        },
        "decision_ref": {
          "type": "string"
        },
        "evaluated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": true
    }
  }
}
