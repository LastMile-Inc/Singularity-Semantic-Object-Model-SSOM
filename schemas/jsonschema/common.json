{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ssom.dev/schema/common.json",
  "title": "SSOM Common Types",
  "type": "object",
  "$defs": {
    "assetForm": {
      "type": "string",
      "enum": [
        "system",
        "unit",
        "machine",
        "assembly",
        "component",
        "instrument",
        "controller",
        "software",
        "logical_asset"
      ]
    },
    "equipmentRole": {
      "type": "string",
      "enum": [
        "process_equipment",
        "utility_equipment",
        "material_handling_equipment",
        "facility_equipment",
        "production_equipment"
      ]
    },
    "deviceRole": {
      "type": "string",
      "enum": [
        "sensing_device",
        "measurement_device",
        "actuation_device",
        "control_device",
        "protection_device",
        "communication_device",
        "compute_device"
      ]
    },
    "lifecycleRole": {
      "type": "string",
      "enum": [
        "serialized_asset",
        "maintainable_asset",
        "replaceable_unit",
        "monitored_asset",
        "critical_asset",
        "cyber_managed_asset",
        "safety_related_asset"
      ]
    },
    "classificationAssertion": {
      "type": "object",
      "required": [
        "classification_scheme",
        "classification_category",
        "classification_code",
        "confidence"
      ],
      "properties": {
        "classification_scheme": {
          "type": "string"
        },
        "classification_category": {
          "type": "string",
          "enum": [
            "asset_form",
            "equipment_role",
            "device_role",
            "lifecycle_role",
            "source_type",
            "derived_role",
            "extension"
          ]
        },
        "classification_code": {
          "type": "string"
        },
        "asserted_by": {
          "type": "string"
        },
        "source_reference": {
          "type": "string"
        },
        "valid_from": {
          "type": "string",
          "format": "date-time"
        },
        "valid_to": {
          "type": "string",
          "format": "date-time"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "derivation_method": {
          "type": "string"
        },
        "semantic_profile_version": {
          "type": "string"
        },
        "provenance": {
          "$ref": "common.json#/$defs/provenance"
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_platform",
        "source_authority_id",
        "source_reference",
        "lineage_id",
        "ingest_time",
        "processing_time"
      ],
      "properties": {
        "source_platform": {
          "type": "string"
        },
        "source_authority_id": {
          "type": "string"
        },
        "source_reference": {
          "type": "string"
        },
        "source_message_identity": {
          "type": "string"
        },
        "mapping_package_id": {
          "type": "string"
        },
        "mapping_version": {
          "type": "string"
        },
        "adapter_version": {
          "type": "string"
        },
        "lineage_id": {
          "type": "string"
        },
        "ingest_time": {
          "type": "string",
          "format": "date-time"
        },
        "processing_time": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": true
    },
    "quality": {
      "type": "object",
      "required": [
        "status",
        "validation_status"
      ],
      "properties": {
        "status": {
          "enum": [
            "good",
            "uncertain",
            "bad",
            "estimated",
            "missing"
          ]
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_quality": {},
        "mapping_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "identity_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "validation_status": {
          "enum": [
            "valid",
            "invalid",
            "partial",
            "quarantined"
          ]
        }
      },
      "additionalProperties": true
    },
    "temporalIntegrity": {
      "type": "object",
      "required": [
        "event_time",
        "receive_time",
        "processing_time",
        "delivery_classification"
      ],
      "properties": {
        "event_time": {
          "type": "string",
          "format": "date-time"
        },
        "source_time": {
          "type": "string",
          "format": "date-time"
        },
        "receive_time": {
          "type": "string",
          "format": "date-time"
        },
        "processing_time": {
          "type": "string",
          "format": "date-time"
        },
        "time_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ordering_scope": {
          "type": "string"
        },
        "delivery_classification": {
          "enum": [
            "live",
            "retained_snapshot",
            "replay",
            "backfill",
            "late_arrival",
            "reconstructed",
            "manual_entry"
          ]
        }
      },
      "additionalProperties": true
    },
    "confidenceScore": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "stateLineage": {
      "type": "object",
      "properties": {
        "valid_from": {
          "type": "string",
          "format": "date-time"
        },
        "valid_to": {
          "type": "string",
          "format": "date-time"
        },
        "correction_of_ref": {
          "type": "string"
        },
        "supersedes_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "superseded_by_ref": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "responsibleParty": {
      "type": "object",
      "properties": {
        "actor_ref": {
          "type": "string"
        },
        "actor_name": {
          "type": "string"
        },
        "model_id": {
          "type": "string"
        },
        "model_version": {
          "type": "string"
        },
        "authority_ref": {
          "type": "string"
        }
      },
      "anyOf": [
        {
          "required": [
            "actor_ref"
          ]
        },
        {
          "required": [
            "model_id"
          ]
        }
      ],
      "additionalProperties": true
    },
    "decisionAuthority": {
      "type": "object",
      "required": [
        "authority_id",
        "authority_type"
      ],
      "properties": {
        "authority_id": {
          "type": "string"
        },
        "authority_type": {
          "type": "string",
          "enum": [
            "human",
            "team",
            "workflow",
            "policy_engine",
            "model",
            "system"
          ]
        },
        "display_name": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "predictionHorizon": {
      "type": "object",
      "required": [
        "target_time"
      ],
      "properties": {
        "target_time": {
          "type": "string",
          "format": "date-time"
        },
        "horizon_start": {
          "type": "string",
          "format": "date-time"
        },
        "horizon_end": {
          "type": "string",
          "format": "date-time"
        },
        "horizon_duration": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "expectedOutcome": {
      "type": "object",
      "required": [
        "description"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "target_metric": {
          "type": "string"
        },
        "target_value": {},
        "unit": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "observedOutcome": {
      "type": "object",
      "required": [
        "description"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "result_class": {
          "type": "string",
          "enum": [
            "improved",
            "unchanged",
            "degraded",
            "successful",
            "unsuccessful",
            "mixed",
            "unknown"
          ]
        },
        "measured_metric": {
          "type": "string"
        },
        "measured_value": {},
        "unit": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "sourceAssertionState": {
      "type": "string",
      "enum": [
        "reported",
        "confirmed",
        "contradicted",
        "superseded",
        "retracted",
        "stale"
      ]
    },
    "decisionStatus": {
      "type": "string",
      "enum": [
        "approved",
        "rejected",
        "deferred",
        "selected",
        "overridden"
      ]
    },
    "actionStatus": {
      "type": "string",
      "enum": [
        "planned",
        "authorized",
        "in_progress",
        "completed",
        "cancelled",
        "failed",
        "partial"
      ]
    },
    "priorityLevel": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ]
    },
    "policyEvidence": {
      "type": "object",
      "properties": {
        "classification": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "retention_class": {
          "type": "string"
        },
        "sharing_eligibility": {
          "type": "string"
        },
        "decision_ref": {
          "type": "string"
        },
        "evaluated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": true
    }
  }
}
