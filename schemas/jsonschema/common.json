{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ssom.dev/schema/common.json",
  "title": "SSOM Common Types",
  "type": "object",
  "$defs": {
    "assetForm": {
      "type": "string",
      "enum": [
        "system",
        "unit",
        "machine",
        "assembly",
        "component",
        "instrument",
        "controller",
        "software",
        "logical_asset"
      ]
    },
    "equipmentRole": {
      "type": "string",
      "enum": [
        "process_equipment",
        "utility_equipment",
        "material_handling_equipment",
        "facility_equipment",
        "production_equipment"
      ]
    },
    "deviceRole": {
      "type": "string",
      "enum": [
        "sensing_device",
        "measurement_device",
        "actuation_device",
        "control_device",
        "protection_device",
        "communication_device",
        "compute_device"
      ]
    },
    "lifecycleRole": {
      "type": "string",
      "enum": [
        "serialized_asset",
        "maintainable_asset",
        "replaceable_unit",
        "monitored_asset",
        "critical_asset",
        "cyber_managed_asset",
        "safety_related_asset"
      ]
    },
    "identifierRole": {
      "type": "string",
      "enum": [
        "canonical_ssom_id",
        "manufacturer_serial_number",
        "manufacturer_model_identifier",
        "engineering_tag",
        "asset_tag",
        "functional_location_reference",
        "eam_equipment_id",
        "cmdb_ci_id",
        "historian_tag",
        "opc_ua_node_id",
        "opc_ua_namespace_uri",
        "scada_object_id",
        "bms_object_id",
        "oem_cloud_id",
        "network_identity",
        "finance_asset_id",
        "maintenance_vendor_id",
        "digital_twin_id"
      ]
    },
    "identifierSemanticUsage": {
      "type": "string",
      "enum": [
        "external_identity",
        "alias",
        "contextual_reference"
      ]
    },
    "identifierVerificationStatus": {
      "type": "string",
      "enum": [
        "observed",
        "verified",
        "unverified",
        "disputed",
        "superseded"
      ]
    },
    "identifierScope": {
      "type": "object",
      "required": [
        "scope_type",
        "scope_value"
      ],
      "properties": {
        "scope_type": {
          "type": "string",
          "enum": [
            "enterprise",
            "site",
            "area",
            "source_system",
            "namespace",
            "oem_tenant",
            "functional_location",
            "network_domain",
            "custom"
          ]
        },
        "scope_value": {
          "type": "string"
        },
        "scope_path": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "identifierAuthority": {
      "type": "object",
      "required": [
        "authority_id"
      ],
      "properties": {
        "authority_id": {
          "type": "string"
        },
        "authority_type": {
          "type": "string",
          "enum": [
            "source_system",
            "organization",
            "vendor",
            "namespace",
            "registry",
            "custom"
          ]
        },
        "display_name": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "identifierAssignment": {
      "type": "object",
      "required": [
        "assignment_id",
        "identifier_value",
        "identifier_role",
        "semantic_usage",
        "identifier_scope",
        "identifier_authority",
        "verification_status",
        "confidence",
        "provenance"
      ],
      "properties": {
        "assignment_id": {
          "type": "string"
        },
        "identifier_value": {
          "type": "string"
        },
        "identifier_role": {
          "$ref": "common.json#/$defs/identifierRole"
        },
        "semantic_usage": {
          "$ref": "common.json#/$defs/identifierSemanticUsage"
        },
        "identifier_scope": {
          "$ref": "common.json#/$defs/identifierScope"
        },
        "identifier_authority": {
          "$ref": "common.json#/$defs/identifierAuthority"
        },
        "verification_status": {
          "$ref": "common.json#/$defs/identifierVerificationStatus"
        },
        "assigned_by": {
          "type": "string"
        },
        "valid_from": {
          "type": "string",
          "format": "date-time"
        },
        "valid_to": {
          "type": "string",
          "format": "date-time"
        },
        "confidence": {
          "$ref": "common.json#/$defs/confidenceScore"
        },
        "source_assertion_ref": {
          "type": "string"
        },
        "provenance": {
          "$ref": "common.json#/$defs/provenance"
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "identityLifecycleEventType": {
      "type": "string",
      "enum": [
        "commissioning",
        "decommissioning",
        "replacement",
        "recommissioning",
        "relocation",
        "tag_reassignment",
        "merge",
        "split",
        "source_system_migration"
      ]
    },
    "assetSuccessionType": {
      "type": "string",
      "enum": [
        "replaces",
        "replaced_by",
        "succeeds",
        "preceded_by",
        "split_into",
        "merged_from",
        "decommissioned_as",
        "recommissioned_as"
      ]
    },
    "quantityKind": {
      "type": "string",
      "enum": [
        "pressure",
        "temperature",
        "volumetric_flow_rate",
        "vibration_velocity",
        "vibration_acceleration",
        "voltage",
        "current",
        "rotational_speed",
        "energy",
        "level",
        "concentration",
        "position",
        "valve_position_fraction_open",
        "valve_travel_length"
      ]
    },
    "unitReference": {
      "type": "object",
      "required": [
        "unit_code",
        "vocabulary_id"
      ],
      "properties": {
        "unit_code": {
          "type": "string"
        },
        "vocabulary_id": {
          "type": "string"
        },
        "symbol": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "dimension": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "sourceMeasurementRepresentation": {
      "type": "string",
      "enum": [
        "numeric_scalar",
        "boolean_state",
        "string_state",
        "structured_payload"
      ]
    },
    "originalMeasurement": {
      "type": "object",
      "required": [
        "source_value",
        "source_unit",
        "source_timestamp",
        "source_representation"
      ],
      "properties": {
        "source_value": {},
        "source_unit": {
          "$ref": "common.json#/$defs/unitReference"
        },
        "source_timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "source_quality": {
          "$ref": "common.json#/$defs/quality"
        },
        "source_representation": {
          "$ref": "common.json#/$defs/sourceMeasurementRepresentation"
        }
      },
      "additionalProperties": true
    },
    "canonicalMeasurement": {
      "type": "object",
      "required": [
        "quantity_kind",
        "canonical_value",
        "canonical_unit"
      ],
      "properties": {
        "quantity_kind": {
          "$ref": "common.json#/$defs/quantityKind"
        },
        "canonical_value": {},
        "canonical_unit": {
          "$ref": "common.json#/$defs/unitReference"
        }
      },
      "additionalProperties": true
    },
    "conversionLineage": {
      "type": "object",
      "required": [
        "source_unit",
        "canonical_unit",
        "conversion_method",
        "conversion_service",
        "conversion_version",
        "conversion_timestamp"
      ],
      "properties": {
        "source_unit": {
          "$ref": "common.json#/$defs/unitReference"
        },
        "canonical_unit": {
          "$ref": "common.json#/$defs/unitReference"
        },
        "formula_reference": {
          "type": "string"
        },
        "conversion_method": {
          "type": "string"
        },
        "conversion_service": {
          "type": "string"
        },
        "conversion_version": {
          "type": "string"
        },
        "conversion_timestamp": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": true
    },
    "measurementQuality": {
      "type": "object",
      "required": [
        "quality_code",
        "communication_quality",
        "validity_status",
        "missing_data_state",
        "stale_data_state"
      ],
      "properties": {
        "quality_code": {
          "type": "string",
          "enum": [
            "good",
            "degraded",
            "bad",
            "estimated",
            "missing"
          ]
        },
        "communication_quality": {
          "type": "string",
          "enum": [
            "good",
            "degraded",
            "lost",
            "unknown"
          ]
        },
        "validity_status": {
          "type": "string",
          "enum": [
            "valid",
            "invalid",
            "suspect",
            "interpolated",
            "substituted"
          ]
        },
        "uncertainty": {
          "type": "number",
          "minimum": 0
        },
        "accuracy": {
          "type": "number",
          "minimum": 0
        },
        "precision": {
          "type": "number",
          "minimum": 0
        },
        "missing_data_state": {
          "type": "string",
          "enum": [
            "present",
            "partially_missing",
            "missing"
          ]
        },
        "stale_data_state": {
          "type": "string",
          "enum": [
            "fresh",
            "stale",
            "unknown"
          ]
        }
      },
      "additionalProperties": true
    },
    "calibrationContext": {
      "type": "object",
      "required": [
        "calibration_status"
      ],
      "properties": {
        "calibration_reference": {
          "type": "string"
        },
        "calibration_status": {
          "type": "string",
          "enum": [
            "calibrated",
            "due",
            "overdue",
            "out_of_service",
            "unknown"
          ]
        },
        "last_known_calibration_date": {
          "type": "string",
          "format": "date-time"
        },
        "next_due_status": {
          "type": "string",
          "enum": [
            "not_due",
            "due_soon",
            "overdue",
            "unknown"
          ]
        },
        "sensor_ref": {
          "type": "string"
        },
        "instrument_ref": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "measurementRange": {
      "type": "object",
      "required": [
        "low",
        "high",
        "unit"
      ],
      "properties": {
        "low": {
          "type": "number"
        },
        "high": {
          "type": "number"
        },
        "unit": {
          "$ref": "common.json#/$defs/unitReference"
        }
      },
      "additionalProperties": true
    },
    "measurementPoint": {
      "type": "object",
      "required": [
        "value",
        "unit"
      ],
      "properties": {
        "value": {},
        "unit": {
          "$ref": "common.json#/$defs/unitReference"
        },
        "basis": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "aggregationMethod": {
      "type": "string",
      "enum": [
        "raw_sample",
        "average",
        "min",
        "max",
        "median",
        "rms",
        "sum",
        "delta"
      ]
    },
    "signalContext": {
      "type": "object",
      "required": [
        "measurement_target_ref"
      ],
      "properties": {
        "measurement_target_ref": {
          "type": "string"
        },
        "source_device_ref": {
          "type": "string"
        },
        "source_signal_ref": {
          "type": "string"
        },
        "engineering_unit": {
          "$ref": "common.json#/$defs/unitReference"
        },
        "display_unit": {
          "$ref": "common.json#/$defs/unitReference"
        },
        "engineering_range": {
          "$ref": "common.json#/$defs/measurementRange"
        },
        "operational_range": {
          "$ref": "common.json#/$defs/measurementRange"
        },
        "setpoint": {
          "$ref": "common.json#/$defs/measurementPoint"
        },
        "alarm_threshold": {
          "$ref": "common.json#/$defs/measurementPoint"
        },
        "baseline": {
          "$ref": "common.json#/$defs/measurementPoint"
        },
        "sampling_interval": {
          "type": "string"
        },
        "aggregation_method": {
          "$ref": "common.json#/$defs/aggregationMethod"
        },
        "operating_mode_context": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "timeSynchronizationContext": {
      "type": "object",
      "required": [
        "source_timestamp",
        "ingestion_timestamp"
      ],
      "properties": {
        "source_timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "ingestion_timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "clock_source_context": {
          "type": "string"
        },
        "clock_reference": {
          "type": "string"
        },
        "ordering_state": {
          "type": "string",
          "enum": [
            "in_order",
            "out_of_order",
            "late_arrival",
            "replayed"
          ]
        },
        "clock_offset_ms": {
          "type": "number"
        }
      },
      "additionalProperties": true
    },
    "governedTermReference": {
      "type": "object",
      "required": [
        "scheme",
        "code"
      ],
      "properties": {
        "scheme": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "diagnosticStatus": {
      "type": "string",
      "enum": [
        "suspected",
        "confirmed",
        "ruled_out",
        "superseded"
      ]
    },
    "prognosticStatus": {
      "type": "string",
      "enum": [
        "projected",
        "watch",
        "escalated",
        "expired",
        "superseded"
      ]
    },
    "failureEventStatus": {
      "type": "string",
      "enum": [
        "detected",
        "confirmed",
        "active",
        "mitigated",
        "resolved"
      ]
    },
    "maintenanceStrategyType": {
      "type": "string",
      "enum": [
        "corrective",
        "preventive",
        "predictive",
        "condition_based",
        "run_to_failure",
        "proof_test"
      ]
    },
    "workRequestStatus": {
      "type": "string",
      "enum": [
        "requested",
        "approved",
        "rejected",
        "deferred",
        "cancelled"
      ]
    },
    "workPlanStatus": {
      "type": "string",
      "enum": [
        "draft",
        "approved",
        "revised",
        "cancelled"
      ]
    },
    "verificationStatus": {
      "type": "string",
      "enum": [
        "verified",
        "rejected",
        "inconclusive",
        "pending"
      ]
    },
    "restorationStatus": {
      "type": "string",
      "enum": [
        "restored",
        "not_restored",
        "partially_restored",
        "inconclusive"
      ]
    },
    "workOutcomeDisposition": {
      "type": "string",
      "enum": [
        "positive",
        "neutral",
        "negative",
        "inconclusive",
        "ineffective",
        "unresolved"
      ]
    },
    "recurrenceStatus": {
      "type": "string",
      "enum": [
        "none",
        "suspected",
        "confirmed",
        "open",
        "closed"
      ]
    },
    "materialUsage": {
      "type": "object",
      "required": [
        "material_ref",
        "quantity"
      ],
      "properties": {
        "material_ref": {
          "$ref": "common.json#/$defs/governedTermReference"
        },
        "quantity": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "$ref": "common.json#/$defs/unitReference"
        },
        "serial_number": {
          "type": "string"
        },
        "batch_id": {
          "type": "string"
        },
        "warranty_reference": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "laborParticipation": {
      "type": "object",
      "required": [
        "participant_type",
        "participant_ref"
      ],
      "properties": {
        "participant_type": {
          "type": "string",
          "enum": [
            "employee",
            "contractor",
            "vendor",
            "team"
          ]
        },
        "participant_ref": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "labor_hours": {
          "type": "number",
          "minimum": 0
        },
        "organization": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "serviceInterruption": {
      "type": "object",
      "required": [
        "interruption_type",
        "duration_hours"
      ],
      "properties": {
        "interruption_type": {
          "type": "string",
          "enum": [
            "full_outage",
            "partial_outage",
            "degraded_service",
            "planned_shutdown",
            "none"
          ]
        },
        "duration_hours": {
          "type": "number",
          "minimum": 0
        },
        "production_loss_estimate": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "operatingContextSnapshot": {
      "type": "object",
      "required": [
        "asset_class"
      ],
      "properties": {
        "asset_class": {
          "type": "string"
        },
        "operating_mode": {
          "type": "string"
        },
        "load_band": {
          "type": "string"
        },
        "environmental_context": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "impactAssessment": {
      "type": "object",
      "required": [
        "direction",
        "description"
      ],
      "properties": {
        "direction": {
          "type": "string",
          "enum": [
            "improved",
            "unchanged",
            "degraded",
            "unknown"
          ]
        },
        "description": {
          "type": "string"
        },
        "magnitude": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "reliabilityImpact": {
      "type": "object",
      "required": [
        "direction",
        "description",
        "asset_class",
        "operating_context",
        "measurement_evidence_refs",
        "work_history_refs"
      ],
      "properties": {
        "direction": {
          "type": "string",
          "enum": [
            "improved",
            "unchanged",
            "degraded",
            "unknown"
          ]
        },
        "description": {
          "type": "string"
        },
        "asset_class": {
          "type": "string"
        },
        "operating_context": {
          "$ref": "common.json#/$defs/operatingContextSnapshot"
        },
        "measurement_evidence_refs": {
          "$ref": "common.json#/$defs/evidenceRefs"
        },
        "work_history_refs": {
          "$ref": "common.json#/$defs/evidenceRefs"
        },
        "magnitude": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "assessment_basis": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "warrantyCoverage": {
      "type": "object",
      "required": [
        "coverage_status"
      ],
      "properties": {
        "coverage_status": {
          "type": "string",
          "enum": [
            "active",
            "expired",
            "unknown"
          ]
        },
        "coverage_reference": {
          "type": "string"
        },
        "coverage_end": {
          "type": "string",
          "format": "date-time"
        },
        "provider": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "recurrenceContext": {
      "type": "object",
      "required": [
        "recurrence_status"
      ],
      "properties": {
        "recurrence_status": {
          "$ref": "common.json#/$defs/recurrenceStatus"
        },
        "prior_failure_event_refs": {
          "$ref": "common.json#/$defs/evidenceRefs"
        },
        "prior_work_refs": {
          "$ref": "common.json#/$defs/evidenceRefs"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "eventCategory": {
      "type": "string",
      "enum": [
        "operational_occurrence",
        "state_transition",
        "fault",
        "communication",
        "work_lifecycle",
        "safety",
        "data_quality",
        "asset_lifecycle"
      ]
    },
    "eventSourcePayload": {
      "type": "object",
      "required": [
        "payload_format"
      ],
      "properties": {
        "payload_format": {
          "type": "string"
        },
        "payload": {
          "type": "object",
          "additionalProperties": true
        },
        "payload_reference": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "alarmState": {
      "type": "string",
      "enum": [
        "active",
        "acknowledged",
        "cleared",
        "suppressed",
        "shelved",
        "unknown"
      ]
    },
    "alarmStateTransitionType": {
      "type": "string",
      "enum": [
        "raised",
        "acknowledged",
        "cleared",
        "suppressed",
        "unsuppressed",
        "shelved",
        "unshelved",
        "reclassified",
        "state_change"
      ]
    },
    "stateTransitionContext": {
      "type": "object",
      "required": [
        "from_state",
        "to_state",
        "transition_type",
        "event_time",
        "confidence"
      ],
      "properties": {
        "from_state": {
          "type": "string"
        },
        "to_state": {
          "type": "string"
        },
        "transition_type": {
          "$ref": "common.json#/$defs/alarmStateTransitionType"
        },
        "event_time": {
          "type": "string",
          "format": "date-time"
        },
        "valid_from": {
          "type": "string",
          "format": "date-time"
        },
        "valid_to": {
          "type": "string",
          "format": "date-time"
        },
        "confidence": {
          "$ref": "common.json#/$defs/confidenceScore"
        },
        "source_event_ref": {
          "type": "string"
        },
        "evidence_refs": {
          "$ref": "common.json#/$defs/evidenceRefs"
        }
      },
      "additionalProperties": true
    },
    "thresholdReference": {
      "type": "object",
      "required": [
