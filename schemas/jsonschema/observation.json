{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ssom.dev/schema/observation.json",
  "title": "SSOM Observation",
  "type": "object",
  "required": [
    "record_id",
    "subject_ref",
    "metric",
    "value",
    "event_time",
    "quality",
    "provenance",
    "temporal_integrity",
    "ssom_version"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^urn:ssom:record:"
    },
    "ssom_version": {
      "type": "string"
    },
    "subject_ref": {
      "type": "string"
    },
    "metric": {
      "type": "string"
    },
    "value": {},
    "unit": {
      "type": "string"
    },
    "event_time": {
      "type": "string",
      "format": "date-time"
    },
    "quality": {
      "$ref": "common.json#/$defs/quality"
    },
    "provenance": {
      "$ref": "common.json#/$defs/provenance"
    },
    "temporal_integrity": {
      "$ref": "common.json#/$defs/temporalIntegrity"
    },
    "policy_evidence": {
      "$ref": "common.json#/$defs/policyEvidence"
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
