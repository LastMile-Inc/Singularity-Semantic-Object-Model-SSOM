{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ssom.dev/schema/observation.json",
  "title": "SSOM Observation",
  "description": "A time-indexed measurement or state value that may retain both original source measurement semantics and canonical normalized measurement semantics.",
  "type": "object",
  "required": [
    "record_id",
    "subject_ref",
    "metric",
    "value",
    "event_time",
    "quality",
    "provenance",
    "temporal_integrity",
    "ssom_version"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^urn:ssom:record:"
    },
    "semantic_truth_state": {
      "type": "string",
      "const": "observation"
    },
    "ssom_version": {
      "type": "string"
    },
    "subject_ref": {
      "type": "string"
    },
    "metric": {
      "type": "string"
    },
    "value": {},
    "unit": {
      "type": "string"
    },
    "event_time": {
      "type": "string",
      "format": "date-time"
    },
    "quality": {
      "$ref": "common.json#/$defs/quality"
    },
    "original_measurement": {
      "$ref": "common.json#/$defs/originalMeasurement"
    },
    "canonical_measurement": {
      "$ref": "common.json#/$defs/canonicalMeasurement"
    },
    "conversion_lineage": {
      "$ref": "common.json#/$defs/conversionLineage"
    },
    "measurement_quality": {
      "$ref": "common.json#/$defs/measurementQuality"
    },
    "calibration_context": {
      "$ref": "common.json#/$defs/calibrationContext"
    },
    "signal_context": {
      "$ref": "common.json#/$defs/signalContext"
    },
    "time_synchronization_context": {
      "$ref": "common.json#/$defs/timeSynchronizationContext"
    },
    "provenance": {
      "$ref": "common.json#/$defs/provenance"
    },
    "temporal_integrity": {
      "$ref": "common.json#/$defs/temporalIntegrity"
    },
    "policy_evidence": {
      "$ref": "common.json#/$defs/policyEvidence"
    },
    "state_lineage": {
      "$ref": "common.json#/$defs/stateLineage"
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "canonical_measurement"
        ]
      },
      "then": {
        "required": [
          "original_measurement",
          "conversion_lineage"
        ]
      }
    }
  ],
  "additionalProperties": true
}
