{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ssom.dev/schema/safety-foundation-bundle.json",
  "title": "SSOM Functional Safety Foundation Bundle",
  "description": "Bounded safety-context bundle for foundational safety semantics and traceability.",
  "type": "object",
  "required": [
    "bundle_id",
    "profile_id",
    "profile_version",
    "scope_boundary",
    "assets",
    "safety_contexts",
    "work_actions",
    "verification_evidence",
    "safety_events",
    "relationships"
  ],
  "properties": {
    "bundle_id": {
      "type": "string",
      "pattern": "^urn:ssom:safety-foundation:"
    },
    "profile_id": {
      "const": "safety-context-profile"
    },
    "profile_version": {
      "type": "string"
    },
    "scope_boundary": {
      "type": "string"
    },
    "assets": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": [
          "canonical_asset_id",
          "asset_label",
          "safety_asset_role"
        ],
        "properties": {
          "canonical_asset_id": {
            "type": "string"
          },
          "asset_label": {
            "type": "string"
          },
          "safety_asset_role": {
            "type": "string",
            "enum": [
              "sensor_element",
              "logic_solver",
              "final_element",
              "controlled_process_asset",
              "safety_related_asset"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "safety_contexts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "context_id",
          "context_label",
          "safety_function_label",
          "related_process_asset_id",
          "sensor_asset_id",
          "logic_solver_asset_id",
          "final_element_asset_id",
          "bypass_state",
          "proof_test_status",
          "verification_evidence_refs",
          "work_action_refs"
        ],
        "properties": {
          "context_id": {
            "type": "string"
          },
          "context_label": {
            "type": "string"
          },
          "safety_function_label": {
            "type": "string"
          },
          "related_process_asset_id": {
            "type": "string"
          },
          "sensor_asset_id": {
            "type": "string"
          },
          "logic_solver_asset_id": {
            "type": "string"
          },
          "final_element_asset_id": {
            "type": "string"
          },
          "bypass_state": {
            "type": "string",
            "enum": [
              "not_applied",
              "active",
              "cleared"
            ]
          },
          "bypass_active_until": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "proof_test_status": {
            "type": "string",
            "enum": [
              "not_due",
              "scheduled",
              "completed",
              "failed"
            ]
          },
          "verification_evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "work_action_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "work_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "work_action_id",
          "status",
          "opened_at"
        ],
        "properties": {
          "work_action_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "in_progress",
              "closed",
              "completed"
            ]
          },
          "opened_at": {
            "type": "string",
            "format": "date-time"
          },
          "closed_at": {
            "type": ["string", "null"],
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    },
    "verification_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "evidence_id",
          "evidence_type",
          "recorded_at"
        ],
        "properties": {
          "evidence_id": {
            "type": "string"
          },
          "evidence_type": {
            "type": "string",
            "enum": [
              "proof_test",
              "functional_check",
              "inspection",
              "work_verification"
            ]
          },
          "recorded_at": {
            "type": "string",
            "format": "date-time"
          },
          "related_work_action_id": {
            "type": ["string", "null"]
          }
        },
        "additionalProperties": false
      }
    },
    "safety_events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "event_id",
          "event_type",
          "event_time",
          "related_context_id",
          "related_asset_id"
        ],
        "properties": {
          "event_id": {
            "type": "string"
          },
          "event_type": {
            "type": "string",
            "enum": [
              "safety_related_event",
              "bypass_activated",
              "bypass_cleared",
              "proof_test_completed",
              "proof_test_failed",
              "work_closed"
            ]
          },
          "event_time": {
            "type": "string",
            "format": "date-time"
          },
          "related_context_id": {
            "type": "string"
          },
          "related_asset_id": {
            "type": "string"
          },
          "related_work_action_id": {
            "type": ["string", "null"]
          },
          "severity": {
            "type": ["string", "null"]
          }
        },
        "additionalProperties": false
      }
    },
    "relationships": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "relationship_id",
          "from_asset_id",
          "to_asset_id",
          "relationship_type"
        ],
        "properties": {
          "relationship_id": {
            "type": "string"
          },
          "from_asset_id": {
            "type": "string"
          },
          "to_asset_id": {
            "type": "string"
          },
          "relationship_type": {
            "type": "string",
            "enum": [
              "senses",
              "evaluates",
              "acts_on",
              "protects",
              "controls"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}