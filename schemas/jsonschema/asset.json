{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ssom.dev/schema/asset.json",
  "title": "SSOM Asset",
  "description": "Asset is the canonical lifecycle identity for physical or logical entities participating in industrial operations. Equipment and Device are overlapping operational classifications of an Asset.",
  "type": "object",
  "required": [
    "asset_id",
    "asset_type",
    "display_name",
    "lifecycle_state",
    "ssom_version",
    "identity"
  ],
  "properties": {
    "asset_id": {
      "type": "string",
      "pattern": "^urn:ssom:asset:"
    },
    "asset_type": {
      "type": "string",
      "description": "Source or semantic type retained from the authoritative system or mapping."
    },
    "display_name": {
      "type": "string"
    },
    "lifecycle_state": {
      "type": "string"
    },
    "asset_form": {
      "$ref": "common.json#/$defs/assetForm"
    },
    "equipment_roles": {
      "type": "array",
      "items": {
        "$ref": "common.json#/$defs/equipmentRole"
      },
      "uniqueItems": true
    },
    "device_roles": {
      "type": "array",
      "items": {
        "$ref": "common.json#/$defs/deviceRole"
      },
      "uniqueItems": true
    },
    "lifecycle_roles": {
      "type": "array",
      "items": {
        "$ref": "common.json#/$defs/lifecycleRole"
      },
      "uniqueItems": true
    },
    "primary_operational_role": {
      "oneOf": [
        {
          "$ref": "common.json#/$defs/equipmentRole"
        },
        {
          "$ref": "common.json#/$defs/deviceRole"
        }
      ]
    },
    "ssom_version": {
      "type": "string"
    },
    "identity": {
      "type": "object",
      "required": [
        "source_references",
        "confidence"
      ],
      "properties": {
        "source_references": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "source_platform",
              "source_reference"
            ],
            "properties": {
              "source_platform": {
                "type": "string"
              },
              "source_reference": {
                "type": "string"
              },
              "authority": {
                "type": "string"
              }
            }
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "identifier_assignments": {
          "type": "array",
          "items": {
            "$ref": "common.json#/$defs/identifierAssignment"
          }
        }
      }
    },
    "classification_assertions": {
      "type": "array",
      "items": {
        "$ref": "common.json#/$defs/classificationAssertion"
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": true
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
